# Anchored with a leading slash: these are Python build directories at the repo root only.
# Unanchored, `lib/` matches any directory named lib at any depth -- which silently swallowed
# react_frontend/src/lib/ and broke the Vercel build with "Cannot find module '../lib/api'".
