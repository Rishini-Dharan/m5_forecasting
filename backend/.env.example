# Backend environment variables. Copy to backend/.env and fill in.

# Required
DATABASE_URL=postgresql://user:password@host:port/database

# Required outside local development. Without it the app falls back to a public
# development key and logs a warning - tokens would be forgeable.
JWT_SECRET_KEY=change-me-to-a-random-32-plus-character-string

# Comma-separated frontend origins. Must be explicit (no "*") because the API
# sends credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face repo holding the trained M5 models
NPN_REPO=rishini/NPN

ENVIRONMENT=development
LOG_LEVEL=INFO
DB_POOL_MIN=2
DB_POOL_MAX=10

# Optional: override the seeded admin account
# SEED_ADMIN_EMAIL=admin@m5.com
# SEED_ADMIN_PASSWORD=change-me
